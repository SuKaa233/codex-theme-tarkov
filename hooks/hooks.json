{
  "description": "Non-blocking tactical sound cues for Codex lifecycle events.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sound-hook.mjs\"",
            "commandWindows": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','sound-hook.mjs')).href)\"",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sound-hook.mjs\"",
            "commandWindows": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','sound-hook.mjs')).href)\"",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sound-hook.mjs\"",
            "commandWindows": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','sound-hook.mjs')).href)\"",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sound-hook.mjs\"",
            "commandWindows": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.PLUGIN_ROOT,'hooks','sound-hook.mjs')).href)\"",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
